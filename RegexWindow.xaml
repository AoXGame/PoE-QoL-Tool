<Window x:Class="PoeSvintus.RegexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beast Regex Strings" Height="300" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="CenterOwner"
        MouseDown="Window_MouseDown">
    <Border Background="{StaticResource DarkBackground}" BorderBrush="{StaticResource DarkBorder}" BorderThickness="1" CornerRadius="8">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Beast Regex Strings" Foreground="{StaticResource AccentPink}" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Best beast:" Foreground="{StaticResource DarkTextSecondary}" Margin="0,0,0,5"/>
                <TextBox x:Name="GoodBeastsBox" Margin="0,0,0,10"/>
                
                <TextBlock Text="Rare beast:" Foreground="{StaticResource DarkTextSecondary}" Margin="0,0,0,5"/>
                <TextBox x:Name="BadBeast1Box" Margin="0,0,0,10"/>
                
                <TextBlock Text="Bad beast:" Foreground="{StaticResource DarkTextSecondary}" Margin="0,0,0,5"/>
                <TextBox x:Name="BadBeast2Box" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Save" Width="80" Margin="5" Click="Save_Click"/>
                <Button Content="Cancel" Width="80" Margin="5" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
