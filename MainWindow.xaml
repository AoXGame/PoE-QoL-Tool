<Window x:Class="PoeSvintus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PoE Svintus LIFE" Height="750" Width="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        Topmost="True"
        Icon="123.ico">
    
    <Border Background="{StaticResource DarkBackground}" 
            BorderBrush="{StaticResource DarkBorder}" 
            BorderThickness="1" 
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/> <!-- Custom Title Bar -->
                <RowDefinition Height="*"/>   <!-- Main Content -->
                <RowDefinition Height="25"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#252526" CornerRadius="8,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <Image Source="123.ico" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PoE Svintus LIFE" 
                                   Foreground="{StaticResource DarkTextPrimary}" 
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Button Content="" FontFamily="Segoe MDL2 Assets" Width="30" Height="25" Style="{StaticResource SecondaryButton}" Click="Minimize_Click" Background="Transparent" FontSize="10"/>
                        <Button Content="" FontFamily="Segoe MDL2 Assets" Width="30" Height="25" Style="{StaticResource SecondaryButton}" Click="Close_Click" Background="Transparent" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                <StackPanel>
                    <!-- Hotkeys List -->
                    <GroupBox Header="Hotkeys and Functions">
                        <StackPanel Margin="5,0">
                            <!-- Fusing/Jew -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Currency/CurrencyRerollSocketLinks.png" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" x:Name="Key_Fusing" Text="None" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" Width="45" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="Fast Fusing/Jew" Foreground="{StaticResource DarkTextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Set" Width="35" Height="18" Padding="0" Click="SetHotkey_Click" Tag="Fusing" Style="{StaticResource SecondaryButton}" FontSize="9"/>
                            </Grid>
                            
                            <!-- Stash -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Currency/CurrencyIdentification.png" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" x:Name="Key_Stash" Text="None" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" Width="45" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="Move to stash" Foreground="{StaticResource DarkTextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Setup" Width="40" Height="18" Margin="0,0,5,0" Padding="0" Click="StashSetup_Click" FontSize="10"/>
                                <Button Grid.Column="4" Content="Set" Width="35" Height="18" Padding="0" Click="SetHotkey_Click" Tag="Stash" Style="{StaticResource SecondaryButton}" FontSize="9"/>
                            </Grid>

                            <!-- Gem Swap -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Gems/Support/ArcaneSurge.png" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" x:Name="Key_GemSwap" Text="None" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" Width="45" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="Gem Swap" Foreground="{StaticResource DarkTextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Set" Width="35" Height="18" Padding="0" Click="SetHotkey_Click" Tag="GemSwap" Style="{StaticResource SecondaryButton}" FontSize="9"/>
                            </Grid>

                            <!-- Key Spam (Keyboard Icon) -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentYellow}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
                                <TextBlock Grid.Column="1" x:Name="Key_KeySpam" Text="None" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" Width="45" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="Key Spam" Foreground="{StaticResource DarkTextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Set" Width="35" Height="18" Padding="0" Click="SetHotkey_Click" Tag="KeySpam" Style="{StaticResource SecondaryButton}" FontSize="9"/>
                            </Grid>

<!-- Scour/Alch -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Currency/CurrencyUpgradeToRare.png" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" x:Name="Key_Scour" Text="None" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" Width="45" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="Scour + Alch" Foreground="{StaticResource DarkTextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Setup" Width="40" Height="18" Margin="0,0,5,0" Padding="0" Click="ScourAlchSetup_Click" FontSize="10"/>
                                <Button Grid.Column="4" Content="Set" Width="35" Height="18" Padding="0" Click="SetHotkey_Click" Tag="Scour" Style="{StaticResource SecondaryButton}" FontSize="9"/>
                            </Grid>

                            <!-- Chaos Spam -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Currency/CurrencyAddModToRare.png" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" x:Name="Key_Chaos" Text="None" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" Width="45" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="Chaos Spam" Foreground="{StaticResource DarkTextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Setup" Width="40" Height="18" Margin="0,0,5,0" Padding="0" Click="ChaosSetup_Click" FontSize="10"/>
                                <Button Grid.Column="4" Content="Set" Width="35" Height="18" Padding="0" Click="SetHotkey_Click" Tag="Chaos" Style="{StaticResource SecondaryButton}" FontSize="9"/>
                            </Grid>



                            <!-- Beast Store/Delete -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Currency/BestiaryOrbFull.png" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" x:Name="Key_Beast" Text="None" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" Width="45" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="Beast Action" Foreground="{StaticResource DarkTextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Set" Width="35" Height="18" Padding="0" Click="SetHotkey_Click" Tag="Beast" Style="{StaticResource SecondaryButton}" FontSize="9"/>
                            </Grid>


                        </StackPanel>
                    </GroupBox>

                    <!-- GemSwap Controls -->
                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Gems/SkillGemBlue.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="GemSwap"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Button Content="Mode" Width="50" Click="GemSwapMode_Click"/>
                                <Button Content="Setup" Width="50" Click="GemSwapSetup_Click"/>
                                <Button Content="Help" Width="50" Click="GemSwapHelp_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="GemSwapModeText" Text="Mode: 2 Gems" Foreground="{StaticResource DarkTextPrimary}"/>
                            <TextBlock x:Name="GemSwapStatusText" Text="Status: Ready" Foreground="{StaticResource DarkTextSecondary}" FontSize="10"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Key Spam Settings -->
                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Gems/DetonateDead.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Key Spam"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Delay:" Foreground="{StaticResource DarkTextPrimary}" VerticalAlignment="Center"/>
                                <Slider x:Name="DetonateSlider" Margin="45,0,30,0" Minimum="50" Maximum="200" Value="100" Style="{StaticResource RoundGreySlider}" ValueChanged="DetonateSlider_ValueChanged"/>
                                <TextBlock x:Name="DetonateDelayText" Text="100" Foreground="{StaticResource DarkTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Bestiary Controls -->
                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Currency/BestiaryCaptureNet5.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Bestiary"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <UniformGrid Columns="2" Margin="0,5">
                                <Button Content="Mode" Click="BeastMode_Click"/>
                                <Button Content="Setup" Click="BeastSetup_Click"/>
                                <Button Content="Regex" Click="BeastFilter_Click"/>
                                <Button Content="Help" Click="BeastHelp_Click"/>
                            </UniformGrid>
                            <TextBlock x:Name="BeastModeText" Text="Mode: Store" Foreground="{StaticResource DarkTextPrimary}"/>
                            <TextBlock x:Name="BeastStatusText" Text="Status: Ready" Foreground="{StaticResource DarkTextSecondary}" FontSize="10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock x:Name="BeastStatsText" Text="Del G:0 B:0 | Str G:0 B:0" Foreground="{StaticResource AccentGreen}" FontSize="10" VerticalAlignment="Center"/>
                                <Button Content="Reset" Margin="10,0" Padding="5,2" Click="ResetStats_Click"/>
                                <Button Content="Stats" Padding="5,2" Click="ToggleStatsWindow_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Area Search Settings -->
                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z" 
                                      Fill="{StaticResource AccentYellow}" Width="14" Height="14" Margin="0,0,5,0" Stretch="Uniform"/>
                                <TextBlock Text="Area Search"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid Margin="0,5">
                                <Button Content="Select Search Area" HorizontalAlignment="Stretch" Height="25" Click="SelectArea_Click"/>
                            </Grid>
                            <TextBlock x:Name="AreaCoordsText" Text="Area: Not Selected" Foreground="{StaticResource DarkTextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hotkey: Ctrl+Alt+D to search" Foreground="{StaticResource DarkTextSecondary}" FontSize="9" HorizontalAlignment="Center" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="https://web.poecdn.com/image/Art/2DItems/Currency/CurrencyModValues.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Quick Tools"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid Margin="0,4">
                                <TextBlock Text="League:" VerticalAlignment="Center" Foreground="{StaticResource DarkTextPrimary}"/>
                                <ComboBox x:Name="LeagueCombo" Margin="70,0,0,0" Height="24" SelectionChanged="LeagueCombo_SelectionChanged"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <TextBlock Text="Divine rate:" VerticalAlignment="Center" Foreground="{StaticResource DarkTextPrimary}"/>
                                <TextBox x:Name="DivineRateEdit" Margin="70,0,75,0" Text="155" HorizontalContentAlignment="Center"/>
                                <Button Content="Update" HorizontalAlignment="Right" Width="70" Height="24" Click="RefreshRate_Click"/>
                            </Grid>
                            
                            <Border Background="#2A2A2A" Height="1" Margin="0,10"/>
                            <TextBlock Text="Quick Change Calculator" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" FontSize="12"/>
                            
                            <Grid Margin="0,3">
                                <TextBlock Text="Item (DIV):" VerticalAlignment="Center" Foreground="{StaticResource DarkTextSecondary}"/>
                                <TextBox x:Name="ItemPriceDIV" Margin="85,0,0,0" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Div Received:" VerticalAlignment="Center" Foreground="{StaticResource DarkTextSecondary}"/>
                                <TextBox x:Name="DivineGet" Margin="85,0,0,0" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Chaos Received:" VerticalAlignment="Center" Foreground="{StaticResource DarkTextSecondary}"/>
                                <TextBox x:Name="ChaosGet" Margin="85,0,0,0" HorizontalContentAlignment="Center"/>
                            </Grid>
                            
                            <Button Content="Calculate Change" Margin="0,10,0,5" Height="30" FontWeight="Bold" Click="CalcDivine_Click"/>
                            
                            <Grid Margin="0,3">
                                <TextBlock Text="Change (C):" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentPink}"/>
                                <TextBox x:Name="ChangeReturn" Margin="85,0,0,0" IsReadOnly="True" FontWeight="Bold" Background="#1E1E1E" BorderBrush="{StaticResource AccentPink}" HorizontalContentAlignment="Center" FontSize="14"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Settings -->
                    <GroupBox Header="Settings">
                        <StackPanel>
                            <Grid Margin="0,5,0,0">
                                <TextBlock Text="Volume:" VerticalAlignment="Center"/>
                                <Slider x:Name="VolumeSlider" Margin="50,0,0,0" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.1" LargeChange="0.2" Style="{StaticResource RoundGreySlider}" ValueChanged="VolumeSlider_ValueChanged" PreviewMouseLeftButtonUp="Slider_PreviewMouseLeftButtonUp"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <TextBlock Text="Alpha:" VerticalAlignment="Center"/>
                                <Slider x:Name="AlphaSlider" Margin="50,0,0,0" Minimum="50" Maximum="255" Value="200" Style="{StaticResource RoundGreySlider}" ValueChanged="AlphaSlider_ValueChanged" PreviewMouseLeftButtonUp="Slider_PreviewMouseLeftButtonUp"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#1A1A1A" CornerRadius="0,0,8,8" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status:" Foreground="{StaticResource AccentYellow}" Margin="0,0,5,0"/>
                    <TextBlock x:Name="StatusFunction" Text="Idle" Foreground="{StaticResource DarkTextPrimary}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
