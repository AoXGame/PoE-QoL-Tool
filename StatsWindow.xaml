<Window x:Class="PoeSvintus.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beast Statistics" Height="220" Width="180"
        WindowStyle="None" AllowsTransparency="True" Background="#CC2B2B2B" 
        Topmost="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="5">
        <StackPanel Margin="10">
            <TextBlock Text="Beast Statistics" Foreground="#FF69B4" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <Grid Margin="0,2">
                <TextBlock Text="Del Good:" Foreground="#FFFF00"/>
                <TextBlock x:Name="StatsDelGood" Text="0" Foreground="White" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
                <TextBlock Text="Del Bad:" Foreground="#FFFF00"/>
                <TextBlock x:Name="StatsDelBad" Text="0" Foreground="White" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
                <TextBlock Text="Str Good:" Foreground="#FFFF00"/>
                <TextBlock x:Name="StatsStrGood" Text="0" Foreground="White" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
                <TextBlock Text="Str Bad:" Foreground="#FFFF00"/>
                <TextBlock x:Name="StatsStrBad" Text="0" Foreground="White" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Text="Alpha:" Foreground="White" Margin="0,10,0,0"/>
            <Slider x:Name="StatsAlphaSlider" Minimum="50" Maximum="255" Value="200" Margin="0,2" ValueChanged="StatsAlphaSlider_ValueChanged" Style="{StaticResource RoundGreySlider}"/>

            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button Content="Reset" Click="Reset_Click" Margin="2" Height="25"/>
                <Button Content="Close" Click="Close_Click" Margin="2" Height="25"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
